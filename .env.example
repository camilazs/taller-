GRPC_ADDRESS=localhost:50051
GRPC_TLS=false
GRPC_TOKEN=
DATA_DIR=./data
GRPC_BIND=127.0.0.1:50051
# Optional TLS directly on the gRPC server
GRPC_CERT_PATH=
GRPC_KEY_PATH=
# Optional real vision provider (OpenAI-compatible chat completions)
AI_PROVIDER=openai
# Claude: AI_PROVIDER=anthropic, AI_BASE_URL=https://api.anthropic.com/v1
# Claude model available during verification: claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# json_schema (OpenAI strict output); json_object for compatible providers
AI_RESPONSE_FORMAT=json_schema
# Generación real de mallas GLB desde una imagen (Meshy, cuenta con créditos)
MESHY_API_KEY=
MESHY_MODEL=latest
# Set for cloud access to the web app; enter the same password in the UI
APP_PASSWORD=
